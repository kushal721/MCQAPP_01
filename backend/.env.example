# MongoDB connection string
DATABASE_URL=mongodb://127.0.0.1:27017/MCQ
# Port the API listens on
PORT=4000
# Allowed frontend origin (use * during development)
CORS_ORIGIN=*
# Secret used to sign admin login tokens (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# How long an admin stays signed in
JWT_EXPIRES_IN=12h
